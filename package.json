{
  "name": "visual-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:db": "node --test db/test/schema.test.mjs db/test/import.test.mjs",
    "test": "npm run test:db && node --test tests/*.test.mjs",
    "posters:fetch": "node --env-file-if-exists=.env scripts/fetch-posters.mjs",
    "metadata:fetch": "node --env-file-if-exists=.env scripts/fetch-metadata.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:import": "node db/import.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.8"
  }
}
